OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL_FALLBACK=gpt-4o-mini
OPENAI_STT_MODEL=gpt-transcribe
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEMO_SEED=2035
DEMO_OFFLINE=0
WHISPER_MODEL=large-v3

# --- доступ и защита (документ 11). Секреты: python scripts/gen_codes.py ---
# prod: защита всегда включена, /docs выключены, cookie Secure, автозакрытие корзины каждые 10 минут
# ENV=prod
# в dev защиту можно включить отдельно (по умолчанию выключена: локальный стенд работает как раньше)
# AUTH_ENFORCE=1
# 10 кодов жюри через запятую (6–8 символов; регистр и дефисы при вводе не важны)
JURY_CODES=
# секрет ведущего (≥ 16 символов), заголовок X-Admin-Token; без него сброс/закрытие корзины недоступны никому
ADMIN_TOKEN=
# ключ подписи cookie; без него — производный от ADMIN_TOKEN
AUTH_SECRET=
# автозакрытие корзины, минут (0 — выключено; по умолчанию 10 в prod, 0 в dev)
# AUTOCLOSE_MIN=10
# CORS_ORIGINS=https://your-demo.example
# COOKIE_SECURE=1
# лимиты (значения по умолчанию из документа 11 §2; общий потолок на IP — с запасом на NAT площадки)
# RL_GET_MIN=120
# RL_POST_MIN=30
# RL_IP_GET_MIN=2400
# RL_IP_POST_MIN=300
# RL_PARSE_GUEST_MIN=10
# RL_LLM_CODE_HOUR=30
# RL_LLM_DAY=300
# RL_STT_CODE_HOUR=20
# RL_SIGN_GUEST_HOUR=5
# RL_SIGN_JURY_HOUR=30
# RL_SIGN_IP_HOUR=20
# RL_AUTH_FAIL=10
# кэш тяжёлых GET в памяти (по умолчанию включён вместе с защитой)
# RESPONSE_CACHE=1
# ACCESS_LOG=logs/access.log

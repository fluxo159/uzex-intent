[Unit]
Description=UZEX Intent API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/opt/uzex-intent/backend
EnvironmentFile=/opt/uzex-intent/.env
Environment=ENV=prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/uzex-intent/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 15
Restart=always
RestartSec=2
TimeoutStopSec=10
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/uzex-intent/logs /opt/uzex-intent/data/cache

[Install]
WantedBy=multi-user.target
